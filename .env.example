# ==============================================================
# StreamVIP (mTube) 主站 Docker Environment Variables Configuration
# ==============================================================

# 运行环境与端口设置
NODE_ENV=production

# 网络安全绑定 (127.0.0.1 表示仅允许本地 Nginx/CF 反向代理访问，严禁公网 IP 直连绕过防火墙)
SERVER_BIND_IP=127.0.0.1
CLIENT_BIND_IP=127.0.0.1
ADMIN_BIND_IP=127.0.0.1

SERVER_PORT=3000
CLIENT_PORT=5173
ADMIN_PORT=5174

# 后台管理员默认凭证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 后端日志等级 (debug | info | warn | error)
LOG_LEVEL=warn

# 是否开启浏览器直传存储节点模式 (true: 直传模式，零主控带宽开销；false: 传统主控中转模式)
ENABLE_DIRECT_UPLOAD=true

# ==============================================================
# 数据分析 (Analytics) 开关
# ==============================================================
# 分析采集总开关（false = 拒绝所有 events/batch 上报；默认 true）
ANALYTICS_ENABLED=true
# 原始 IP 落库开关（true = analytics_events 表额外存原始 clientIp；默认 false，隐私优先）
# 注意：即使关闭，ipHash（加盐哈希）与 GeoIP 国家码仍正常采集
ANALYTICS_STORE_RAW_IP=false
# GeoIP 国家码解析开关（false = 不调用外部 GeoIP 服务，countryCode 恒为空；默认 true）
ANALYTICS_GEOIP_ENABLED=true
# IP 哈希盐（用于 ipHash 加盐，建议配置独立随机值；缺省回退 CLUSTER_SECRET）
ANALYTICS_IP_SALT=

# 主站物理数据与上传文件持久化保存路径
DATA_PATH=./data
UPLOADS_PATH=./data/uploads

# 镜像 Tag 覆盖
SERVER_IMAGE=ghcr.io/qualvey/mtube/server:latest
CLIENT_IMAGE=ghcr.io/qualvey/mtube/client:latest
ADMIN_IMAGE=ghcr.io/qualvey/mtube/admin:latest

# ==============================================================
# 如意支付 (Ruyizf) - VIP 会员支付通道配置
# ==============================================================
# 商户密钥（必填才会启用支付；留空 = 支付禁用，回退模拟支付）
# 部署时由 GitHub Actions Secrets 自动注入（RUIZIF_SECRET），勿提交真实密钥
RUIZIF_SECRET=
# 支付结果异步回调地址（需公网可达；经 client nginx /api/ 反代到 server:3000）
RUIZIF_NOTIFY_URL=https://your-domain.com/api/v1/paywall/notify
# 代收通道编码（当前已启用：4444 数字人民币，限额 100~5000 元）
RUIZIF_CHANNEL=4444
# 支付平台回调源 IP 白名单（逗号分隔；留空 = 不校验来源 IP，仅验签）
RUIZIF_NOTIFY_IPS=
# 支付网关地址与商户号（一般无需修改）
RUIZIF_API_URL=https://api.TCXCY.ruyizf.xyz
RUIZIF_MCH=
