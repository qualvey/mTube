# ==============================================================
# StreamVIP (mTube) 主站 Docker Environment Variables Configuration
# ==============================================================

# 运行环境与端口设置
NODE_ENV=production

# 网络安全绑定 (127.0.0.1 表示仅允许本地 Nginx/CF 反向代理访问，严禁公网 IP 直连绕过防火墙)
SERVER_BIND_IP=127.0.0.1
CLIENT_BIND_IP=127.0.0.1
ADMIN_BIND_IP=127.0.0.1

SERVER_PORT=3000
CLIENT_PORT=5173
ADMIN_PORT=5174

# 后台管理员默认凭证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 后端日志等级 (debug | info | warn | error)
LOG_LEVEL=info

# 是否开启浏览器直传存储节点模式 (true: 直传模式，零主控带宽开销；false: 传统主控中转模式)
ENABLE_DIRECT_UPLOAD=true

# 主站物理数据与上传文件持久化保存路径
DATA_PATH=./data
UPLOADS_PATH=./data/uploads

# 镜像 Tag 覆盖
SERVER_IMAGE=ghcr.io/qualvey/mtube/server:latest
CLIENT_IMAGE=ghcr.io/qualvey/mtube/client:latest
ADMIN_IMAGE=ghcr.io/qualvey/mtube/admin:latest
