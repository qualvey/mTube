# ==============================================================
# Storage Node 独立存储节点 Docker Environment Configuration
# ==============================================================

# 运行环境
NODE_ENV=production

# 网络安全绑定 (0.0.0.0 开放供客户端与主站直连访问；127.0.0.1 仅允许同机 Nginx)
STORAGE_BIND_IP=0.0.0.0

# 宿主机开放端口 (默认 3001)
STORAGE_PORT=3001

# 是否允许浏览器直传 (true: 允许前端跨域直传视频文件)
ENABLE_DIRECT_UPLOAD=true

# 节点标识与自定义名称
NODE_ID=node-02
NODE_NAME=香港 8TB 存储节点 02
IS_DEFAULT=false

# 节点对外暴露可访问的 Base URL (用于主站与播放器访问，例如 http://154.xx.xx.xx:3002 或 https://storage2.yourdomain.com)
PUBLIC_URL=http://localhost:3002

# 主站控制面 API 地址 (节点启动后会自动向主站发起注册与 30s 心跳)
MAIN_SERVER_URL=http://localhost:3000

# 存储节点集群通信密钥 (必须与主站 CLUSTER_SECRET 保持一致)
CLUSTER_SECRET=streamvip-cluster-secret

# 心跳保持间隔时间 (秒)
HEARTBEAT_INTERVAL=30

# 宿主机大容量硬盘存储目录 (持久化保存视频与 50 帧封面)
STORAGE_DATA_PATH=/var/storage/uploads

# 镜像 Tag 覆盖
STORAGE_NODE_IMAGE=ghcr.io/qualvey/mtube/storage-node:latest
